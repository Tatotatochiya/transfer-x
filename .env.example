# TransferX environment. Copy to .env and fill in what you need:
#   cp .env.example .env
# docker-compose.yml reads this file for the db and api services. Every
# setting here maps to backend/app/config.py (the variable name upper-cased).
# Only the first two blocks are required to run locally; everything else is
# optional and switches a feature on.

# ── Database (required) ───────────────────────────────────────────────────
# The db container is created with these, and the API connects with them.
# Inside Docker the API's host is forced to `db` (docker-compose.yml), so
# POSTGRES_HOST only matters when you run the API outside Docker.
POSTGRES_DB=transferx
POSTGRES_USER=transferx
POSTGRES_PASSWORD=transferx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL, when set, wins over the POSTGRES_* values (Railway sets it).
# Leave it unset locally unless you know you need it.
# DATABASE_URL=postgresql://transferx:transferx@db:5432/transferx

# ── Auth (required) ───────────────────────────────────────────────────────
# Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Football data: API-Football (optional) ────────────────────────────────
# Not needed if you restore the reference snapshot (STARTER.md). Needed for
# the data refresh and the backfill scripts, which use your daily quota.
APISPORTS_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Stop calling API-Football when the day's remaining requests fall to this.
APISPORTS_RESERVE=500

# ── AI assistant (optional) ───────────────────────────────────────────────
# LLM_MODEL is the provider's model string; set the matching key.
#   Anthropic:  claude-sonnet-5
#   OpenAI:     gpt-4o
#   DeepSeek:   deepseek/deepseek-chat
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────
# Locally docker-compose.yml points the API at Mailpit (http://localhost:8025),
# so you don't need these. Deployed environments set real SMTP values.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@transferx.local
# SMTP_FROM_NAME=TransferX
# SMTP_USE_TLS=true
# Links in emails and Slack messages point here.
FRONTEND_BASE_URL=http://localhost:5173

# ── Phone push (optional) ─────────────────────────────────────────────────
# Generate a pair with: docker compose exec api python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── Monitoring (optional) ─────────────────────────────────────────────────
# Slack Incoming Webhook for job runs and alerts; nothing is posted when unset.
# SLACK_WEBHOOK_URL=

# ── Currency estimates (optional) ─────────────────────────────────────────
# Daily ECB rates for the "≈ €21M" estimates. Unset uses fixed fallback rates.
# FX_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# ── Product switches ──────────────────────────────────────────────────────
# Clubs and players join by invitation; public sign-up stays off.
ALLOW_CLUB_SELF_REGISTRATION=false
ALLOW_PLAYER_SELF_REGISTRATION=false
# Lite mode is a club member's home until they switch to the full app.
# false makes the full app the default.
LITE_DEFAULT_ON=true
# Demo runs for testers, and house clubs for staff.
DEMO_ENABLED=false
