# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.local

# ── Python ────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
*.log
*.pot
*.mo
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── User-uploaded content ─────────────────────────────────────────────────
backend/uploads/

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Docker ────────────────────────────────────────────────────────────────
*.pid
*.sock

# ── OS / IDE ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Claude Code ───────────────────────────────────────────────────────────
# Everything under .claude/ is local by default (e.g. settings.local.json).
# Project skills are the exception — they're project-level conventions meant
# to be shared, so explicitly un-ignore that subtree.
.claude/*
!.claude/skills/
